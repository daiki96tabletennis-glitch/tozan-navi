{
  "rules": {
    "counts": {
      ".read": true,
      "$id": {
        ".validate": "$id.matches(/^[a-z0-9_]{1,40}$/)",
        "$kind": {
          ".write": "$kind == 'fav' || $kind == 'climbed'",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (data.exists() ? (newData.val() == data.val() + 1 || newData.val() == data.val() - 1) : newData.val() == 1)"
        }
      }
    },
    "hutPush": {
      ".read": false,
      "$id": {
        ".write": "$id.matches(/^[0-9a-f]{64}$/)",
        ".validate": "newData.hasChildren(['endpoint', 'keys', 'alerts'])",
        "endpoint": {
          ".validate": "newData.isString() && newData.val().length < 1000 && newData.val().beginsWith('https://')"
        },
        "keys": {
          "p256dh": {
            ".validate": "newData.isString() && newData.val().length < 200"
          },
          "auth": {
            ".validate": "newData.isString() && newData.val().length < 100"
          },
          "$other": {
            ".validate": false
          }
        },
        "alerts": {
          "$i": {
            ".validate": "$i.matches(/^(1?[0-9])$/) && newData.hasChildren(['id', 'stay'])",
            "id": {
              ".validate": "newData.isString() && newData.val().matches(/^hut-[0-9a-f]{8}$/)"
            },
            "stay": {
              ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "admin": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "hutPushSent": {
      ".read": false,
      ".write": false
    },
    "hutPushTrial": {
      ".read": false,
      "$id": {
        ".write": "$id.matches(/^[0-9a-f]{64}$/)",
        ".validate": "newData.hasChildren(['endpoint', 'keys', 'at'])",
        "endpoint": {
          ".validate": "newData.isString() && newData.val().length < 1000 && newData.val().beginsWith('https://')"
        },
        "keys": {
          "p256dh": {
            ".validate": "newData.isString() && newData.val().length < 200"
          },
          "auth": {
            ".validate": "newData.isString() && newData.val().length < 100"
          },
          "$other": {
            ".validate": false
          }
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "adminDash": {
      ".read": "auth != null && auth.uid === 'OWNER_UID_NOT_SET'",
      "revenue": {
        ".write": "auth != null && auth.uid === 'OWNER_UID_NOT_SET'",
        "$ym": {
          ".validate": "$ym.matches(/^[0-9]{4}-[0-9]{2}$/) && newData.hasChildren(['rakuten', 'amazon'])",
          "rakuten": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "amazon": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
