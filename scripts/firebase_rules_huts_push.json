{
  "_説明": "山小屋の予約開始の通知（プッシュ通知）で預かるデータの読み書きの制限。Firebase コンソール → Realtime Database → ルール に、この rules の中身（hutPush と hutPushSent）を、いまあるルールの rules の中へ書き足す（お気に入り数・登頂数のルールを消さない）。実際の Firebase では未検証なので、貼ったあと「ルールのプレイグラウンド」と管理者端末のテスト通知で確かめる。",
  "rules": {
    "hutPush": {
      ".read": false,
      "$id": {
        ".write": "$id.matches(/^[0-9a-f]{64}$/)",
        ".validate": "newData.hasChildren(['endpoint', 'keys', 'alerts'])",
        "endpoint": { ".validate": "newData.isString() && newData.val().length < 1000 && newData.val().beginsWith('https://')" },
        "keys": {
          "p256dh": { ".validate": "newData.isString() && newData.val().length < 200" },
          "auth": { ".validate": "newData.isString() && newData.val().length < 100" },
          "$other": { ".validate": false }
        },
        "alerts": {
          "$i": {
            ".validate": "$i.matches(/^(1?[0-9])$/) && newData.hasChildren(['id', 'stay'])",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^hut-[0-9a-f]{8}$/)" },
            "stay": { ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
            "$other": { ".validate": false }
          }
        },
        "at": { ".validate": "newData.isNumber()" },
        "admin": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "hutPushSent": {
      ".read": false,
      ".write": false
    }
  }
}
